{
  "name": "footballticketsdashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "standalone:prepare": "node scripts/prepare-standalone.mjs",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/db-migrate-prod.ts",
    "db:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/db-setup.ts",
    "import:clubs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/import-clubs.ts",
    "import:football-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/import-football-data.ts",
    "travel:fill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fill-travel-cache.ts",
    "travel:fill:grounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fill-travel-cache-grounds.ts",
    "start": "node server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:standalone": "E2E_STANDALONE=1 playwright test",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
